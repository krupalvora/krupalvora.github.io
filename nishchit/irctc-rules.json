{
  "schema": 1,
  "revision": 1,
  "comment": "Read by the Nishchit mobile app at launch (https://krupalvora.github.io/nishchit/irctc-rules.json). Edit, bump revision, push: installed apps pick it up on their next launch. Keep in sync with extension/rules.js. Host must stay on irctc.co.in (the app refuses anything else).",
  "origin": "https://www.irctc.co.in",
  "chartsPage": "https://www.irctc.co.in/online-charts/",
  "routes": [
    {
      "name": "schedule",
      "method": "GET",
      "path": "^/eticketing/protected/mapps1/trnscheduleenquiry/\\d{5}$"
    },
    {
      "name": "trainComposition",
      "method": "POST",
      "path": "^/online-charts/api/trainComposition$",
      "fields": {
        "trainNo": { "re": "^\\d{5}$" },
        "jDate": { "re": "^\\d{4}-\\d{2}-\\d{2}$" },
        "boardingStation": { "re": "^[A-Z]{1,5}$", "upper": true }
      }
    },
    {
      "name": "coachComposition",
      "method": "POST",
      "path": "^/online-charts/api/coachComposition$",
      "fields": {
        "trainNo": { "re": "^\\d{5}$" },
        "jDate": { "re": "^\\d{4}-\\d{2}-\\d{2}$" },
        "boardingStation": { "re": "^[A-Z]{1,5}$", "upper": true },
        "remoteStation": { "re": "^[A-Z]{1,5}$", "upper": true },
        "trainSourceStation": { "re": "^[A-Z]{1,5}$", "upper": true },
        "coach": { "re": "^[A-Z0-9]{1,4}$", "upper": true },
        "cls": { "re": "^(SL|3A|2A|1A|3E|CC|EC|2S)$", "upper": true }
      }
    }
  ],
  "headers": {
    "accept": "application/json, text/plain, */*",
    "content-type": "application/json",
    "bmirak": "webbm",
    "greq": "{now}"
  },
  "refusal": {
    "statuses": [401, 403, 429, 520],
    "bodyPatterns": ["<title>\\s*Access Denied"]
  },
  "timing": {
    "requestGapMs": 300,
    "requestTimeoutMs": 20000,
    "pageSettleMs": 1500,
    "preferPageForMinutes": 10
  }
}
