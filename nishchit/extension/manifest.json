{
  "manifest_version": 3,
  "name": "Nishchit – Vacant Berth Finder",
  "short_name": "Nishchit",
  "version": "1.1.0",
  "description": "Lets the Nishchit site read the public train reservation chart from your own browser to find berths left vacant.",
  "homepage_url": "https://krupalvora.github.io/nishchit/",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nishchit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://krupalvora.github.io/nishchit/*", "http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "host_permissions": ["https://www.irctc.co.in/*"],
  "permissions": ["scripting"]
}
